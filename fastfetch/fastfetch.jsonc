{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "/home/x/.config/fastfetch/accii.txt"
    },
    "display": {
        "separator": " // ",
        "color": {
            "keys": "magenta",
            "title": "cyan"
        },
        "brightColor": false
    },
    "modules": [
        {
            "type": "os",
            "key": "OS",
            "keyColor": "magenta"
        },
        {
            "type": "wm",
            "key": "WM",
            "keyColor": "magenta"
        },
        {
            "type": "kernel",
            "key": "KERNEL",
            "keyColor": "magenta"
        },
        {
            "type": "uptime",
            "key": "UPTIME",
            "keyColor": "magenta"
        },
        {
            "type": "packages",
            "key": "PKGS",
            "format": "{all}",
            "keyColor": "magenta"
        },
        {
            "type": "board",
            "key": "BOARD",
            "keyColor": "cyan"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "showPeCoreCount": true,
            "keyColor": "cyan"
        },
        {
            "type": "gpu",
            "key": "GPU",
            "keyColor": "cyan"
        },
        {
            "type": "memory",
            "key": "MEM",
            "keyColor": "cyan"
        },
        {
            "type": "disk",
            "key": "BOOT",
            "folders": "/",
            "keyColor": "cyan"
        },
        {
            "type": "disk",
            "key": "STORAGE",
            "folders": "/mnt/backup",
            "keyColor": "cyan"
        }
  ]
}
